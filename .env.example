# ==============================================================================
# SOCIAL MEDIA AUTO PUBLISHING MODULE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application & Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173
JWT_SECRET=super_secret_jwt_key_replace_in_production_min_32_chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # 32 bytes hex for AES-256-GCM

# PostgreSQL & Prisma
DATABASE_URL=postgresql://autopub:autopub_secret_password@localhost:5432/autopub_db?schema=public
POSTGRES_USER=autopub
POSTGRES_PASSWORD=autopub_secret_password
POSTGRES_DB=autopub_db
POSTGRES_PORT=5432

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_pass

# MinIO / AWS S3 Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_secret
S3_BUCKET_NAME=social-media-assets
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/social-media-assets

# Meta Graph API (Facebook Pages)
# Create App at: https://developers.facebook.com
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_API_VERSION=v21.0
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/social-accounts/facebook/callback

# Google Cloud OAuth 2.0 (YouTube Data API v3)
# Create Credentials at: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/social-accounts/youtube/callback
