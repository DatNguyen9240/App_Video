# ==============================================================================
# SOCIAL MEDIA AUTO PUBLISHING MODULE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application & Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173
JWT_SECRET=super_secret_jwt_key_replace_in_production_min_32_chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # 32 bytes hex for AES-256-GCM

# PostgreSQL & Prisma
DATABASE_URL=postgresql://autopub:autopub_secret_password@localhost:5432/autopub_db?schema=public
POSTGRES_USER=autopub
POSTGRES_PASSWORD=autopub_secret_password
POSTGRES_DB=autopub_db
POSTGRES_PORT=5432

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_pass

# MinIO / AWS S3 Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_secret
S3_BUCKET_NAME=social-media-assets
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/social-media-assets

# Meta Graph API (Facebook Pages)
# Create App at: https://developers.facebook.com
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_API_VERSION=v21.0
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/social-accounts/facebook/callback

# Google Cloud OAuth 2.0 (YouTube Data API v3)
# Create Credentials at: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/social-accounts/youtube/callback

# Meta Threads API
THREADS_APP_ID=your_threads_app_id_here
THREADS_APP_SECRET=your_threads_app_secret_here
THREADS_OAUTH_REDIRECT_URI=http://localhost:3000/api/social-accounts/threads/callback

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
TIKTOK_OAUTH_REDIRECT_URI=http://localhost:3000/api/social-accounts/tiktok/callback

# ==============================================================================
# PYTHON VIDEO AUTOMATION ENGINE
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
PLATFORM=threads
LAYOUT_PRESET=center
BG_MODE=minecraft
CARD_THEME=light
TTS_VOICE=nam_bac
TTS_RATE=+0%
BGM_CHOICE=gentle_piano_satie.mp3
BGM_VOLUME=25

# ==============================================================================
# MARKET INTELLIGENCE, CLOUDFLARE WORKER & TELEGRAM REMOTE CONTROL
# ==============================================================================
CLOUDFLARE_WORKER_URL=https://app-video-scheduler.doctortphat.workers.dev
CLOUDFLARE_APP_TOKEN=replace_with_shared_app_video_api_token
CLOUDFLARE_CLIENT_ID=app-video-desktop
DRIVE_WORKSPACE_FOLDER_ID=1F5m2t3uPxSlicE8PQW70xjf7FSC6345g
MARKET_DATA_SUBFOLDER=01_Market_Data
MARKET_SYNC_INTERVAL_SEC=300
REMOTE_POLL_INTERVAL_SEC=10
MUSE_WEB_URL=https://muse.ai/

