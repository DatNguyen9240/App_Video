# ========================================================
# CẤU HÌNH API KEY VÀ HỆ THỐNG
# Lấy Gemini API key miễn phí tại: https://aistudio.google.com/app/apikey
# Đổi tên file này thành .env và điền key của bạn
# ========================================================

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Chế độ nền: 'gradient' (nền màu chuyển sắc sang trọng) hoặc 'minecraft' (video gameplay)
BG_MODE=gradient

# Giọng đọc tiếng Việt: 'vi-VN-NamMinhNeural' (Nam) hoặc 'vi-VN-HoaiMyNeural' (Nữ)
TTS_VOICE=vi-VN-NamMinhNeural

# Tốc độ đọc: '+0%' (chuẩn), '+10%' (khuyên dùng), '+15%' (nhanh cuốn)
TTS_RATE=+10%
