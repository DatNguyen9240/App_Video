# Environment variables & API keys (CHỨA KEY BẢO MẬT, TUYỆT ĐỐI KHÔNG PUSH)
.env
*.env
!.env.example

# Video nền nặng (GitHub chặn file > 100MB, file gameplay thường hàng GB)
assets/backgrounds/**/*.mp4
assets/backgrounds/**/*.mkv
assets/backgrounds/**/*.mov
assets/backgrounds/**/*.avi
assets/backgrounds/*.mp4
assets/backgrounds/*.mkv
assets/backgrounds/*.mov
assets/backgrounds/*.avi
!assets/backgrounds/.gitkeep
!assets/backgrounds/infinity_base*.mp4

# Video satisfying mẫu tải về ngoài máy (chỉ giữ lại script/sample nhẹ dưới 100KB)
assets/satisfying/**/*.mp4
assets/satisfying/**/*.mkv
assets/satisfying/**/*.mov
assets/satisfying/**/*.avi
!assets/satisfying/**/.gitkeep
!assets/satisfying/food/sample_food.mp4
!assets/satisfying/puzzle/sample_puzzle.mp4

# Thư mục xuất file sản phẩm (video render, audio tạm, ảnh card tạm)
output/*
!output/.gitkeep
!output/**/.gitkeep

# Python cache & virtual environment
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
env/
venv/
ENV/

# IDE & OS temporary files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

